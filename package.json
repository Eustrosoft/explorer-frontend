{
  "name": "explorer-frontend",
  "version": "1.1.0",
  "license": "MIT",
  "scripts": {
    "start:login": "npx nx run login:serve",
    "start:dispatcher": "npx nx run dispatcher:serve",
    "start:explorer": "npx nx run explorer:serve",
    "build:all:stage": "npx nx run-many --target=build --configuration=stage --projects=login,dispatcher,explorer,msg,qtis-test-suite --parallel=3 --skip-nx-cache",
    "build:all:production": "npx nx run-many --target=build --configuration=production --projects=login,dispatcher,explorer,msg,qtis-test-suite --parallel=3 --skip-nx-cache",
    "nx:graph": "npx nx graph",
    "prepare": "husky install"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "19.2.15",
    "@angular/cdk": "18.2.14",
    "@angular/common": "19.2.15",
    "@angular/compiler": "19.2.15",
    "@angular/core": "19.2.15",
    "@angular/forms": "19.2.15",
    "@angular/material": "18.2.14",
    "@angular/platform-browser": "19.2.15",
    "@angular/platform-browser-dynamic": "19.2.15",
    "@angular/router": "19.2.15",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "ng2-pdfjs-viewer": "^17.0.3",
    "rxjs": "~7.8.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/core": "19.2.17",
    "@angular-devkit/schematics": "19.2.17",
    "@angular-eslint/eslint-plugin": "17.0.1",
    "@angular-eslint/eslint-plugin-template": "17.0.1",
    "@angular-eslint/template-parser": "17.0.1",
    "@angular/build": "^19.2.17",
    "@angular/cli": "~19.2.17",
    "@angular/compiler-cli": "19.2.15",
    "@angular/language-service": "19.2.15",
    "@angular/localize": "19.2.15",
    "@typescript-eslint/eslint-plugin": "6.17.0",
    "@typescript-eslint/parser": "6.17.0",
    "cypress": "^13.0.0",
    "eslint": "8.56.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-cypress": "2.15.1",
    "husky": "^8.0.3",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^15.2.0",
